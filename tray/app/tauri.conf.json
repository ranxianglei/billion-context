{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BiliTray",
  "version": "0.1.0",
  "identifier": "com.ranxianglei.billioncontext.tray",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Live billion-context compression stats in your system tray",
    "longDescription": "A standalone system-tray indicator for the billion-context proxy: live sessions, context pressure and cache hit rate, fed by the loopback admin API.",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
