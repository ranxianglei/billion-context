# Byte-exact golden snapshots must check out as LF on every platform (#1305).
# Without this, Git-for-Windows' default autocrlf=true converts them to CRLF at
# checkout and the byte-equal golden gates fail on every Windows CI run.
tests/golden/wire-contract/*.json text eol=lf

# #2631: same failure class for tests doing byte-exact multi-line includes
# against this shipped bundle (Git-for-Windows checks it out CRLF otherwise).
dsh.bundle.patch.yml text eol=lf

# #2489: same failure class for the multi-line trajectory SVG golden.
tests/golden/web-trajectory/*.svg text eol=lf

# #3484: same failure class for the multi-line hit-rate SVG golden.
tests/golden/web-hitrate/*.svg text eol=lf

# #1305 class again, new path: the Vertex fixture's manifest pins each artifact's
# byte size and sha256, and turn-streaming.meta.json is 42 lines — Git-for-Windows'
# autocrlf=true checked it out at 1941 bytes against the recorded 1899, so
# "every fixture artifact matches its recorded digest and size" failed every
# windows-latest leg (run 38982246862).
tests/fixtures/vertex-anthropic/* text eol=lf
