{
  "name": "billion-context",
  "version": "0.1.181",
  "description": "A context-compression plugin — small context windows (a 100K context is enough), 5x fewer tokens, month-long single sessions (billions of tokens), and compression quality — for all agents: pi, OpenCode, Codex, Claude Code, and more. billion-context is all you need.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/agent/dsh-native.js",
    "./server": "./dist/agent/opencode-native.js",
    "./dsh": "./dist/agent/dsh-native.js",
    "./dsh/package.json": "./package.json",
    "./client": "./dist/agent/dsh-native-client.js",
    "./pi": "./dist/agent/pi-inprocess.js",
    "./contract": "./dist/agent/pi-inprocess-contract.js",
    "./contract/schema": "./src/agent/pi-inprocess/schema/bcp-block-v1.json"
  },
  "bin": {
    "bili": "./dist/index.js",
    "bili-proxy": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup && node scripts/check-dist-import-annotations.mjs",
    "registry:snapshot": "node scripts/update-registry-snapshot.mjs",
    "codex-models:snapshot": "node scripts/update-codex-models-snapshot.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node dist/index.js",
    "test:e2e": "node --import tsx --test tests/e2e/e2e-codex.test.ts",
    "test:e2e:fake": "node --import tsx --test tests/e2e/e2e-codex-fake.test.ts",
    "test:e2e:image": "node --import tsx --test tests/e2e/e2e-image-billing.test.ts"
  },
  "keywords": [
    "context",
    "compression",
    "proxy",
    "acp",
    "ai",
    "agent",
    "claude-code",
    "cursor",
    "codex",
    "aider",
    "anthropic",
    "openai",
    "pi-package"
  ],
  "license": "MIT",
  "author": "ranxianglei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranxianglei/billion-context.git"
  },
  "homepage": "https://github.com/ranxianglei/billion-context#readme",
  "bugs": {
    "url": "https://github.com/ranxianglei/billion-context/issues"
  },
  "dependencies": {
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/semver": "^7.7.1",
    "@types/ws": "8.18.2",
    "acp-kernel": "0.0.101",
    "fzstd": "0.1.1",
    "jsonc-parser": "^3.3.1",
    "node-forge": "^1.4.0",
    "semver": "7.8.5",
    "tar": "^7.5.22",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typebox": "1.3.34",
    "typescript": "^5.5.0",
    "undici": "^7.29.0",
    "verdaccio": "^6.10.4",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "dsh.bundle.patch.yml",
    "hermes-plugin",
    "src/agent/pi-inprocess/schema"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/ranxianglei/billion-context/master/docs/logo.png",
    "extensions": [
      "./dist/agent/pi-inprocess.js"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "optionalDependencies": {
    "sharp": "^0.35.4"
  }
}
