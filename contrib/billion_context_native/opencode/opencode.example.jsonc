{
  "$schema": "https://opencode.ai/config.json",
  // This layer does not choose a provider/model or change OAuth, URLs, or proxies.
  "plugins": [
    {
      "package": "/ABS/billion_context_native-source/contrib/billion_context_native/opencode",
      "options": {
        "enabled": true,
        "projects": ["/ABS/EXPLICIT-PROJECT"],
        "sessions": ["ses_EXPLICIT_NATIVE_SESSION"],
        "archiveHome": "/ABS/PRIVATE-NATIVE-ARCHIVE",
        "python": "python3"
      }
    }
  ],
  "mcp": {
    "servers": {
      "billion_context_native": {
        "type": "local",
        "command": ["python3", "/ABS/billion_context_native-source/contrib/billion_context_native/plugin/billion_context_native/mcp_server.py"],
        "environment": {
          "BILLION_CONTEXT_NATIVE_HOME": "/ABS/PRIVATE-NATIVE-ARCHIVE",
          // An empty, dedicated directory prevents unrelated CC transcript discovery.
          "BILLION_CONTEXT_NATIVE_PROJECTS": "/ABS/EMPTY-DEDICATED-PROJECTS"
        },
        "codemode": false,
        "protocol": "legacy"
      }
    }
  },
  "permissions": [
    { "action": "billion_context_native_*", "resource": "*", "effect": "deny" },
    { "action": "billion_context_native_recall_search", "resource": "*", "effect": "allow" },
    { "action": "billion_context_native_recall_get", "resource": "*", "effect": "allow" }
  ]
}
